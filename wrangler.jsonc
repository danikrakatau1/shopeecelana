{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopeecelana",
  "main": "./src/worker-v3-19.js",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,
  "secrets": {
    "required": [
      "SELLER_PASSWORD",
      "SESSION_SECRET",
      "SHOPEE_PARTNER_KEY"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/dashboard",
      "/dashboard/*",
      "/seller-login",
      "/seller-login/*",
      "/api/*",
      "/shopee/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}