{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopeecelana",
  "main": "./src/worker-v3-20.js",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,
  "secrets": {
    "required": [
      "SELLER_PASSWORD",
      "SESSION_SECRET",
      "SHOPEE_PARTNER_KEY"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SHOPEE_KV",
      "id": "f324429410e3408d9485171eeb748f15",
      "preview_id": "f324429410e3408d9485171eeb748f15"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/dashboard",
      "/dashboard/*",
      "/seller-login",
      "/seller-login/*",
      "/api/*",
      "/shopee/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
