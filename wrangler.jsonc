{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopeecelana",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/dashboard",
      "/dashboard/*",
      "/seller-login",
      "/seller-login/*",
      "/api/*",
      "/shopee/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
